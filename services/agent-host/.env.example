PORT=8787

# Multi-arch image. Override only if your registry has a native image for your host architecture.
FATE_CONTAINER_BASE_IMAGE=docker.m.daocloud.io/library/node:22-trixie

# Runtime roots. In Docker these default to /app/runtime and /app/memory-projects.
RUNTIME_ROOT=runtime_spool
MEMORY_ROOT=runtime_spool/memory-projects

CLAUDE_CODE_BIN=claude
BASIC_MEMORY_BIN=/opt/basic-memory/bin/basic-memory
BASIC_MEMORY_LOG_LEVEL=WARNING
FUXI_INIT_CONCURRENCY=5
# core = unblock chat after A01–A05; full = wait for all 16 (Live 100 / strict QA)
FUXI_INIT_GATE=core
CLAUDE_CODE_FUXI_TIMEOUT_MS=1800000
# When MiniMax skips memory tools but still returns <user_visible>, deliver reply instead of hard fail (default on)
BODHISATTVA_SOFT_MEMORY_CONTRACT=1

# Role models. Claude Code uses Anthropic-compatible endpoints.
# Bodhisattva/Gongcao/Luohan use MiniMax M3 first; Host falls back to Ark ark-code-latest.
CLAUDE_MODEL_BODHISATTVA=MiniMax-M3
CLAUDE_MODEL_GONGCAO=MiniMax-M3
CLAUDE_MODEL_LUOHAN=MiniMax-M3
CLAUDE_MODEL_FUXI=deepseek-v4-pro
CLAUDE_FALLBACK_MODEL=ark-code-latest

# Provider credentials. Keep real values only in local .env or compose env.
MINIMAX_ENABLED=1
MINIMAX_API_KEY=
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ARK_API_KEY=
ARK_ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
FATE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# API bootstrap → Basic Memory (must match services/api MEMORY_WRITE_SECRET)
MEMORY_WRITE_SECRET=dev-local-memory-write
