PORT=3000
MONGODB_URI=mongodb://localhost:27017/soulmirror
JWT_SECRET=soulmirror-dev-secret-change-in-production
AI_SERVICE_URL=http://localhost:8001
MEMORY_STORE=false

# Archive 多 Agent（Sprint 1+）
AGENT_HOST_URL=http://127.0.0.1:8787
AGENT_MODE=claude
# Match agent-host: core unlocks chat after A01–A05; full for strict 16/16 QA
FUXI_INIT_GATE=core

# Shared secret for API → agent-host memory writes (bootstrap plan, migrations)
MEMORY_WRITE_SECRET=dev-local-memory-write

# 邮箱注册（本地开发）
EMAIL_VERIFY_ENABLED=true
EMAIL_DEV_MODE=true
# 生产环境再配 SMTP：
# SMTP_HOST= SMTP_PORT=587 SMTP_USERNAME= SMTP_PASSWORD= SMTP_FROM=
