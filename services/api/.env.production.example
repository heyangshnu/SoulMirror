PORT=3010
MONGODB_URI=mongodb://127.0.0.1:27017/soulmirror
JWT_SECRET=请用 openssl rand -hex 32 生成随机字符串
AI_SERVICE_URL=http://127.0.0.1:8010
NODE_ENV=production
MEMORY_STORE=false

# 邮箱注册（与 sub2api sub2api-go/.env 相同 126 邮箱）
EMAIL_VERIFY_ENABLED=true
EMAIL_DEV_MODE=false
SMTP_HOST=smtp.126.com
SMTP_PORT=465
SMTP_USERNAME=subtoapi@126.com
SMTP_PASSWORD=从 sub2api-go/.env 复制 SMTP_PASSWORD
SMTP_FROM=心镜 SoulMirror <subtoapi@126.com>

# 短信（可选，保留兼容）
SMS_DEV_MODE=false
