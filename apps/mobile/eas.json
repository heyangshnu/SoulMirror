{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.soulzenai.com/v1",
        "EXPO_PUBLIC_AGENT_WS_URL": "wss://api.soulzenai.com/v1/agent/stream"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.soulzenai.com/v1",
        "EXPO_PUBLIC_AGENT_WS_URL": "wss://api.soulzenai.com/v1/agent/stream"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
