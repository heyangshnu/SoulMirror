{
  "name": "soulmirror",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/api"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@soulmirror/mobile",
    "api": "npm run start:dev --workspace=@soulmirror/api",
    "api:build": "npm run build --workspace=@soulmirror/api",
    "types:build": "npm run build --workspace=@soulmirror/shared-types",
    "chart:build": "npm run build --workspace=@soulmirror/chart",
    "bazi:build": "npm run build --workspace=@soulmirror/bazi",
    "packages:build": "npm run types:build && npm run chart:build && npm run bazi:build",
    "dev": "concurrently -n api,mobile -c blue,green \"npm run api\" \"npm run mobile\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "agent:install": "npm install --prefix services/agent-host",
    "agent:build": "npm run build --prefix services/agent-host",
    "agent:host": "npm run host --prefix services/agent-host",
    "agent:up": "docker compose -f services/agent-host/docker-compose.yml up -d --build",
    "agent:down": "docker compose -f services/agent-host/docker-compose.yml down",
    "agent:prod:up": "docker compose -f services/agent-host/docker-compose.prod.yml up -d --build",
    "agent:prod:down": "docker compose -f services/agent-host/docker-compose.prod.yml down",
    "agent:health": "curl -sf http://127.0.0.1:8787/health || echo 'agent-host not running'",
    "agent:diagnose": "bash scripts/diagnose-agent.sh",
    "ai": "bash services/ai/run.sh",
    "hybrid:check": "bash scripts/hybrid-dev-check.sh",
    "hybrid:stack": "bash scripts/hybrid-dev-up.sh",
    "hybrid:services": "concurrently -n api,ai -c blue,magenta \"npm run api\" \"npm run ai\"",
    "hybrid:dev": "concurrently -n stack,services -c cyan,green \"npm run hybrid:stack\" \"sleep 8 && npm run hybrid:services\"",
    "agent:validate": "npm run validate:static --prefix services/agent-host && npm run typecheck --prefix services/agent-host",
    "agent:validate:static": "npm run validate:static --prefix services/agent-host",
    "agent:test:live:tesla100": "npm run test:live:tesla100 --prefix services/agent-host",
    "archive:validate": "bash scripts/validate-archive.sh",
    "archive:smoke": "bash scripts/e2e-archive-smoke.sh",
    "archive:migrate-life-context": "node scripts/migrate-life-context-to-memory.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
